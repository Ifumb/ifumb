# Copy to .env.local and fill in. Never commit real values.

# Runtime connection — Supabase pooler in transaction mode (port 6543).
DATABASE_URL=

# Direct connection for the Prisma CLI (port 5432). Read-only commands only on the shared
# database: `prisma generate`, `prisma migrate status`. NEVER `prisma migrate dev`.
DIRECT_URL=

# Auth.js session signing key — generate one with: pnpm dlx auth secret
AUTH_SECRET=

# Public base URL of this app. Read at BUILD time (metadataBase, sitemap, robots) and at runtime
# (links sent by email): a deployment must set it for both, or those URLs point to localhost.
APP_URL=http://localhost:3000

# Public URL of the Supabase project holding member photos (no key: the bucket is public). Read at
# BUILD time (next/image remote pattern) and at runtime. Without it, photos show as initials.
SUPABASE_URL=

# Supabase service role key, used on the server only to store and remove member photos (ADR 0007).
# SECRET: never prefix it with NEXT_PUBLIC_. During the migration, only the staging project's key.
# Without it, photos can be neither added nor removed. Read at runtime.
SUPABASE_SERVICE_ROLE_KEY=

# Business writes (trees, members, unions). Leave unset while DATABASE_URL points at the production
# database shared with the legacy app: every write is then refused (ADR 0005). Set to "true" only
# on a staging or test database, and in production at cutover. Read at runtime.
BUSINESS_WRITES_ENABLED=

# Resend (password reset emails). Without these, "Mot de passe oublié" fails on submit.
RESEND_API_KEY=
RESEND_FROM=
